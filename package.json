{
  "name": "starline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Starline — a cosy story game in Hoshi Valley (three.js + Blender).",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/pack-models.mjs dist/models",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "story:md": "node scripts/story-md.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:check": "node scripts/i18n-extract.mjs --check"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "meshoptimizer": "^0.22.0",
    "playwright": "^1.61.1",
    "vite": "^6.1.0"
  }
}
